{
  "name": "mynum",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation platform for the Numiq and Numviz packages",
  "license": "MIT",
  "author": "munachi-me",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:links": "node scripts/check-links.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:examples && npm run build && npm run check:links"
  },
  "dependencies": {
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "lucide-react": "^1.82.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@munachi-me/numiq": "^2.0.1",
    "@munachi-me/numviz": "^1.0.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
